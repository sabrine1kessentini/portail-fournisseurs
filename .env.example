# Copie ce fichier en .env (local) et renseigne les vraies valeurs.
# .env est ignoré par git (voir .gitignore) — ne jamais committer de secret.

# --- Base de données (Supabase Postgres, plan gratuit) ---
# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (port 6543)
# Utilisée par l'application à l'exécution (compatible pooling serverless).
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Requise par Prisma Migrate (prepared statements non supportés par le pooler en mode
# transaction). Sur le plan gratuit, la connexion directe IPv4 (db.xxxx.supabase.co) n'est
# plus disponible sans l'add-on payant : utiliser le "Session pooler" (même hôte que
# ci-dessus, port 5432) qui reste gratuit et supporte les migrations.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Stockage documents (Supabase Storage, plan gratuit) ---
# Supabase > Project Settings > API
SUPABASE_URL="https://xxxx.supabase.co"
# Clé "service_role" (secrète, jamais exposée au client) — Project Settings > API
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# Nom du bucket de stockage (privé) créé dans Supabase > Storage
SUPABASE_STORAGE_BUCKET="documents"

# --- Email transactionnel (Resend, plan gratuit) ---
RESEND_API_KEY="re_xxxxxxxx"
# Domaine de test Resend (aucune vérification DNS requise) ou ton domaine vérifié
EMAIL_FROM="Portail Fournisseurs <onboarding@resend.dev>"

# --- Sécurité applicative ---
# Secret de signature des sessions acheteur (JWT). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AUTH_SECRET="change-me-minimum-16-caracteres"
# Secret partagé avec Vercel Cron pour protéger /api/cron/* des appels publics.
CRON_SECRET="change-me-minimum-16-caracteres"

# --- URL publique de l'application (utilisée pour construire les liens fournisseurs) ---
# En local : http://localhost:3000
# En production : https://ton-projet.vercel.app
APP_URL="http://localhost:3000"
